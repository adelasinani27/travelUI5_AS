<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="deleteConfirmDialog"
        title="Confirm Deletion"
        type="Message"
        state="Warning">
        <content>
            <VBox id="_IDGenVBox3" class="sapUiSmallMargin">
                <Text id="deleteConfirmText" text="" />
            </VBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton6"
                text="Delete"
                type="Reject"
                press="onConfirmDelete" />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton7"
                text="Cancel"
                press="onCancelDelete" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>